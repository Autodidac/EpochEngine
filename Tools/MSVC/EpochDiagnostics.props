<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="EpochDiagnostics">
    <EpochOpenGLStaticQuads Condition="'$(EpochOpenGLStaticQuads)' == ''">false</EpochOpenGLStaticQuads>
    <EpochTextureDiagnostics Condition="'$(EpochTextureDiagnostics)' == ''">false</EpochTextureDiagnostics>
    <EpochTextureDiagnosticsDefine>0</EpochTextureDiagnosticsDefine>
    <EpochTextureDiagnosticsDefine Condition="'$(EpochTextureDiagnostics)' == 'true' Or '$(EpochTextureDiagnostics)' == '1'">1</EpochTextureDiagnosticsDefine>
    <EpochNvidiaTelemetry Condition="'$(EpochNvidiaTelemetry)' == ''">true</EpochNvidiaTelemetry>
    <EpochNvidiaTelemetryDefine>0</EpochNvidiaTelemetryDefine>
    <EpochNvidiaTelemetryDefine Condition="'$(EpochNvidiaTelemetry)' == 'true' Or '$(EpochNvidiaTelemetry)' == '1'">1</EpochNvidiaTelemetryDefine>
    <EpochNvmlIncludeDir Condition="'$(EpochNvmlIncludeDir)' == '' And Exists('$(CUDA_PATH)\include\nvml.h')">$(CUDA_PATH)\include</EpochNvmlIncludeDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>EPOCH_ENABLE_TEXTURE_DIAGNOSTICS=$(EpochTextureDiagnosticsDefine);EPOCH_ENABLE_NVIDIA_TELEMETRY=$(EpochNvidiaTelemetryDefine);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories Condition="'$(EpochNvidiaTelemetryDefine)' == '1' And Exists('$(EpochNvmlIncludeDir)\nvml.h')">$(EpochNvmlIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <Target Name="EpochValidateTextureDiagnostics" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(EpochTextureDiagnostics)' != 'false' And '$(EpochTextureDiagnostics)' != 'true' And '$(EpochTextureDiagnostics)' != '0' And '$(EpochTextureDiagnostics)' != '1'"
           Text="EpochTextureDiagnostics must be false, true, 0 or 1." />
  </Target>
  <Target Name="EpochValidateOpenGLStaticQuads" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(EpochOpenGLStaticQuads)' != 'false' And '$(EpochOpenGLStaticQuads)' != 'true' And '$(EpochOpenGLStaticQuads)' != '0' And '$(EpochOpenGLStaticQuads)' != '1'"
           Text="EpochOpenGLStaticQuads must be false, true, 0 or 1." />
  </Target>
  <Target Name="EpochValidateNvidiaTelemetry" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(EpochNvidiaTelemetry)' != 'false' And '$(EpochNvidiaTelemetry)' != 'true' And '$(EpochNvidiaTelemetry)' != '0' And '$(EpochNvidiaTelemetry)' != '1'"
           Text="EpochNvidiaTelemetry must be false, true, 0 or 1." />
    <Error Condition="'$(EpochNvidiaTelemetryDefine)' == '1' And '$(EpochNvmlIncludeDir)' != '' And !Exists('$(EpochNvmlIncludeDir)\nvml.h')"
           Text="EpochNvmlIncludeDir must contain the optional NVML SDK header nvml.h, or remain empty for unavailable telemetry." />
  </Target>
</Project>
