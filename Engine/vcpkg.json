{
  "name": "epoch-engine",
  "version-string": "0.88.70",
  "builtin-baseline": "cd61e1e26a038e82d6550a3ebbe0fbbfe7da78e3",
  "dependencies": [
    "asio",
    "curl",
    "glad",
    "glfw3",
    "glm",

    "vulkan-headers",
    {
      "name": "vulkan-loader",
      "features": [
        "xlib"
      ],
      "platform": "linux"
    },
    {
      "name": "vulkan-loader",
      "platform": "!linux"
    },
    "volk",
    "shaderc",
    "spirv-tools",

    {
      "name": "sdl3",
      "platform": "linux",
      "default-features": false,
      "features": [
        "vulkan",
        "x11"
      ]
    },
    {
      "name": "sdl3",
      "platform": "!linux"
    },
    {
      "name": "sfml",
      "default-features": false,
      "features": [
        "graphics"
      ]
    },
    {
      "name": "raylib",
      "default-features": false
    },

    "zlib"
  ]
}
