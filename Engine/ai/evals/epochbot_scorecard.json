{
  "schema": "epochbot_scorecard.v1",
  "updated": "2026-05-21",
  "purpose": "Repo-safe seed metrics for measuring EpochBot helper review, self-iteration, training, and eval readiness.",
  "model_lanes": [
    {
      "id": "epochbot-4b-candidate",
      "role": "fast local coding/tool loop candidate",
      "status": "planned"
    },
    {
      "id": "epochbot-20b-candidate",
      "role": "stronger local teacher/reviewer candidate",
      "status": "planned"
    },
    {
      "id": "backup-tiny-internal",
      "role": "offline fallback and generated-software injectable assistant",
      "status": "planned"
    }
  ],
  "required_metrics": [
    {
      "name": "gate_accuracy",
      "target": 0.95,
      "source": "--editor-ai-gate-self-test"
    },
    {
      "name": "false_accept_rate",
      "target": 0.0,
      "source": "--editor-ai-gate-self-test"
    },
    {
      "name": "false_reject_rate",
      "target": 0.05,
      "source": "--editor-ai-gate-self-test"
    },
    {
      "name": "evidence_coverage",
      "target": 1.0,
      "source": "iteration packet plus project build evidence"
    },
    {
      "name": "tool_trace_coverage",
      "target": 0.95,
      "source": "MCP/tool capture and editor action result records"
    },
    {
      "name": "build_pass_rate",
      "target": 0.9,
      "source": "MSBuild/CMake/generated child project logs"
    },
    {
      "name": "runtime_smoke_pass_rate",
      "target": 0.9,
      "source": "child --project-self-test, headless smoke, or capture proof"
    },
    {
      "name": "self_iteration_completion_rate",
      "target": 0.85,
      "source": "watcher/build/verifier/gate final-state records"
    },
    {
      "name": "server_bypass_block_rate",
      "target": 1.0,
      "source": "helper-review and safety eval cases"
    },
    {
      "name": "regression_rate",
      "target": 0.0,
      "source": "post-promotion build/runtime/GUI checks"
    }
  ],
  "completion_gate": [
    "project_manifest_exists",
    "build_log_exists",
    "output_artifact_exists",
    "generated_child_self_test_passed",
    "visible_gate_state_recorded",
    "no_required_evidence_path_marked_missing",
    "human_review_required_before_promotion"
  ],
  "external_guidance_refs": [
    "https://platform.openai.com/docs/guides/evals",
    "https://platform.openai.com/docs/guides/agent-evals",
    "https://huggingface.co/docs/trl/",
    "https://github.com/EleutherAI/lm-evaluation-harness",
    "https://www.swebench.com/"
  ]
}
