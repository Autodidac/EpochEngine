include(CMakeParseArguments)

function(epoch_platform_add_application target)
    set(options WINDOWED)
    set(one_value_args LINKAGE)
    set(multi_value_args SOURCES)
    cmake_parse_arguments(EPA "${options}" "${one_value_args}" "${multi_value_args}" ${ARGN})

    if(NOT EPA_SOURCES)
        message(FATAL_ERROR "epoch_platform_add_application requires SOURCES")
    endif()
    if(NOT EPA_LINKAGE)
        set(EPA_LINKAGE STATIC)
    endif()
    string(TOUPPER "${EPA_LINKAGE}" EPA_LINKAGE)
    if(EPA_LINKAGE STREQUAL "STATIC")
        set(linkage_suffix Static)
    elseif(EPA_LINKAGE STREQUAL "SHARED")
        set(linkage_suffix Shared)
    else()
        message(FATAL_ERROR "LINKAGE must be STATIC or SHARED")
    endif()

    if(WIN32 AND EPA_WINDOWED)
        add_executable(${target} WIN32 ${EPA_SOURCES})
        set(entrypoint EpochPlatformEntrypointWindowed${linkage_suffix})
    else()
        add_executable(${target} ${EPA_SOURCES})
        set(entrypoint EpochPlatformEntrypointConsole${linkage_suffix})
    endif()

    if(TARGET ${entrypoint})
        set(resolved_entrypoint ${entrypoint})
    elseif(TARGET EpochPlatformEngine::${entrypoint})
        set(resolved_entrypoint EpochPlatformEngine::${entrypoint})
    else()
        string(REPLACE "EpochPlatform" "" imported_suffix "${entrypoint}")
        if(TARGET EpochPlatformEngine::${imported_suffix})
            set(resolved_entrypoint EpochPlatformEngine::${imported_suffix})
        else()
            message(FATAL_ERROR "Requested EpochPlatformEngine ${EPA_LINKAGE} entrypoint target is unavailable")
        endif()
    endif()

    target_compile_features(${target} PRIVATE cxx_std_23)
    target_link_libraries(${target} PRIVATE ${resolved_entrypoint})
endfunction()
